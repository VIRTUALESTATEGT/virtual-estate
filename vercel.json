{
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "assets/fonts/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/assets/:path*", "destination": "/api/index.js" },
    { "source": "/:path*", "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/limpiar",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/meta/refresh-token?platform=instagram",
      "schedule": "0 2 * * 0"
    }
  ]
}
