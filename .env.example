# Supabase — obtén estos valores en https://supabase.com > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SECRET_KEY=tu_service_role_key_aqui

# JWT — elige una cadena larga y aleatoria (mín. 32 caracteres)
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga_y_aleatoria

# Puerto del servidor (Vercel lo ignora, usa el suyo)
PORT=3000

# WhatsApp Business API — Meta Developer App
# App Secret: Meta Developers → tu App → Settings → Basic → App Secret
WHATSAPP_APP_SECRET=
# WA_SIGNATURE_ENFORCE=true → rechaza con 403 firmas inválidas; false (default) → solo loguea
WA_SIGNATURE_ENFORCE=false
